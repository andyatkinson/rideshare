<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <title>Rideshare simulator</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <style>
    * { box-sizing: border-box }
    body { margin: 0 auto; padding: 10px 16px; max-width: 1500px; background: #f3f5f8; color: #17243a; font: 14px system-ui, sans-serif }
    header { display: flex; align-items: center; gap: 10px; margin-bottom: 8px }
    h1 { font-size: 20px; margin: 0; white-space: nowrap } h2 { font-size: 16px; margin: 0 0 6px } p { margin: 6px 0 }
    header .controls { margin-left: auto; display: flex; gap: 6px; align-items: center } #run-status { font-size: 11px; color: #526078 } #start-simulation { background: #176443; color: white; border-color: #176443 } button:disabled { opacity: 0.6; cursor: default } button, summary { cursor: pointer } button { padding: 7px 12px; border: 1px solid #bac7d8; border-radius: 7px; background: white; color: inherit; font: inherit }
    .muted { color: #526078 } .error { color: #a72d24 } #status { font-size: 12px }
    #counts { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; margin-bottom: 8px }
    .counter { background: white; border: 1px solid #d5ddea; border-radius: 7px; padding: 5px 10px }
    .counter strong { display: inline-block; font-size: 19px; margin-right: 8px } .counter > span:first-child { display: block; text-transform: capitalize; font-size: 12px; color: #526078 }
    .delta { color: #176443; font-size: 11px; white-space: nowrap }
    .panel { background: white; border: 1px solid #d5ddea; border-radius: 9px; padding: 8px 10px; min-width: 0 }
    .pool { margin-bottom: 8px } #drivers { display: flex; flex-wrap: wrap; gap: 6px }
    .driver { border: 1px solid #d9b942; border-radius: 6px; padding: 4px 7px; background: #fff3ba; color: #654e00; font-size: 12px }
    .driver.busy { border-color: #69ae80; background: #d9f4e2; color: #145c30 }
    .columns { display: grid; gap: 8px } #active { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px }
    #map { height: clamp(120px, 18vh, 200px); border-radius: 7px; background: #e8eef3; margin-bottom: 8px }
    .map-heading { display: flex; justify-content: space-between; align-items: center; gap: 8px }
    #map-status { font-size: 12px; margin-bottom: 8px } #live-map { padding: 4px 8px; font-size: 12px }
    .position-pin { background: var(--trip-color); border: 2px solid white; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); width: 14px; height: 14px; box-shadow: 0 1px 4px #17243a77 }
    .pin-label { position: absolute; left: 15px; top: -9px; padding: 1px 4px; border-radius: 3px; background: white; color: var(--trip-color); border: 1px solid currentColor; font: bold 10px system-ui; white-space: nowrap }
    .pin-label.left { left: auto; right: 15px }
    .trip-link { padding: 0; border: 0; background: none; color: #245caf; text-decoration: underline; font: inherit }
    .trip-link[aria-pressed="true"] { font-weight: 700; color: #17243a }
    .ride { border: 1px solid #d5ddea; border-left: 4px solid var(--trip-color); background: #f8fafc; border-radius: 7px; padding: 6px 8px; margin: 0; font-size: 12px }
    .ride p { margin: 3px 0 } .badge { float: right; color: var(--trip-color); font-size: 11px; margin-bottom: 4px }
    table { width: 100%; border-collapse: collapse; font-size: 12px } th, td { text-align: left; padding: 5px 6px; border-bottom: 1px solid #e3e8f0; vertical-align: top; overflow-wrap: anywhere }
    th { color: #526078; font-weight: 500 } td:last-child { white-space: nowrap } .table-wrap { overflow-x: auto }
    details { margin-top: 10px } summary { color: #345681; font-size: 12px } .note { font-size: 11px; margin-top: 8px }
    dialog { max-width: 640px; width: calc(100% - 32px); border: 1px solid #bac7d8; border-radius: 12px; padding: 22px; color: inherit }
    dialog::backdrop { background: #17243a77 } dialog button { float: right } pre { padding: 12px; background: #eef2f7; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12px }
    @media (max-width: 600px) { body { padding: 12px } header { flex-wrap: wrap; gap: 8px } #counts { grid-template-columns: repeat(3, 1fr) } #active { grid-template-columns: 1fr } }
  </style>
</head>
<body>
  <header>
    <h1>Rideshare activity</h1>
    <span id="status" role="status">Connecting…</span>
    <div class="controls"><span id="run-status" role="status">Ready</span><button id="start-simulation" type="button">Run 10 trips</button><button id="show-instructions" type="button">How to run</button></div>
  </header>
  <section aria-label="Database counts" id="counts"></section>
  <section class="panel pool">
    <h2>Drivers <span class="muted" id="pool-summary"></span></h2>
    <div id="drivers"></div>
  </section>
  <main class="columns">
    <section class="panel">
      <div class="map-heading"><h2>Trip positions</h2><button id="live-map" type="button" hidden>Back to live</button></div>
      <p id="map-status" role="status">Live positions · Kendall Square ↔ Central Square</p>
      <div id="map" role="region" aria-label="Trip position map"></div>
      <h2>Active rides</h2>
      <div id="active"></div>
    </section>
    <section class="panel">
      <h2>Recent completed rides</h2>
      <div class="table-wrap"><table><thead><tr><th>Trip</th><th>Driver / rider</th><th>Route</th><th>Samples</th><th>Trip rating</th></tr></thead><tbody id="recent"></tbody></table></div>
      <details id="history">
        <summary>More recent rides <span id="history-count"></span></summary>
        <div class="table-wrap"><table aria-label="More completed rides"><thead><tr><th>Trip</th><th>Driver / rider</th><th>Route</th><th>Samples</th><th>Trip rating</th></tr></thead><tbody id="older"></tbody></table></div>
      </details>
      <p class="muted note">Latest 3 shown · up to 15 expanded · trip rating has no separate author field</p>
    </section>
  </main>
  <dialog id="instructions" aria-labelledby="instructions-title">
    <form method="dialog"><button>Close</button></form>
    <h2 id="instructions-title">Run the simulator</h2>
    <p>From the repository directory, run in another terminal:</p>
    <pre>docker compose exec -e SIM_SAMPLES=37 -e SIM_INTERVAL=10 app sh -c 'export PGPASSWORD="$RIDESHARE_DB_PASSWORD"; bin/rails "simulate:app_activity[100]"'</pre>
    <p>For Rails running directly on your machine:</p>
    <pre>SIM_SAMPLES=37 SIM_INTERVAL=10 bin/rails 'simulate:app_activity[100]'</pre>
    <p class="muted">Click Run 10 trips to launch a background Rails task on this server. Five drivers share up to two concurrent rides in opposite directions; 10 six-minute trips take about 30 minutes. Repeated clicks cannot start overlapping runs. Logs are in log/simulator.log.
    </p><p class="muted">Default rides last six minutes: 37 positions, including pickup and arrival, sampled every 10 seconds. For a quick preview use SIM_INTERVAL=0.5. Positions follow saved street geometry; timing is synthetic.</p>
    <p class="muted">Click a completed trip number to inspect its recorded pins; Back to live restores active trips. Completed trips disappear from the live map automatically.</p>
    <p class="muted">Use the same development database as this server. At most two rides run concurrently; positions update during each ride. Yellow drivers are idle; green drivers are on a trip.</p>
    <p class="muted">The page polls every second (five seconds in the background). Counts cover the whole database; growth is measured since opening this page. Actor and location pools are reused while requests, trips and positions accumulate.</p>
  </dialog>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    (() => {
      let starting = false;
      const startButton = document.getElementById('start-simulation');
      const runStatus = document.getElementById('run-status');
      startButton.addEventListener('click', async () => {
        starting = true;
        startButton.disabled = true;
        runStatus.textContent = 'Starting…';
        try {
          const response = await fetch('/simulator/start', { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content, 'Accept': 'application/json' } });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || `HTTP ${response.status}`);
          runStatus.textContent = 'Running · max 2 rides';
        } catch (error) {
          runStatus.textContent = error.message;
        } finally {
          starting = false;
        }
      });
      let baseline, map, pins, selectedTrip = null, selectionVersion = 0, liveTrips = [];
      const tripColors = new Map();
      const palette = ['#087f5b', '#9c36b5', '#c05600', '#1d4ed8'];
      const colorForTrip = id => {
        if (!tripColors.has(id)) tripColors.set(id, palette.find(color => ![...tripColors.values()].includes(color)) || palette[0]);
        return tripColors.get(id);
      };
      const shortName = name => name.replace(/^Simulator /, '');
      const shortLocation = name => name.replace(', Cambridge, MA', '');
      const bounds = [[42.36242, -71.10310], [42.36507, -71.08572]];
      const mapStatus = document.getElementById('map-status');
      if (window.L) {
        map = L.map('map').fitBounds(bounds, { padding: [30, 30] });
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map).on('tileerror', () => { mapStatus.textContent = 'Map tiles unavailable; recorded pins still shown. Internet access is required for tiles.'; });
        pins = L.layerGroup().addTo(map);
      } else {
        mapStatus.textContent = 'Map library unavailable. Check your internet connection and reload; activity below still updates.';
      }
      function drawTrips(trips, history = false) {
        if (!map) return;
        pins.clearLayers();
        trips.forEach(trip => {
          const color = history ? (tripColors.get(trip.id) || '#1d4ed8') : colorForTrip(trip.id);
          const left = !history && palette.indexOf(color) % 2 === 0;
          const positions = trip.positions || [];
          if (positions.length > 1) {
            L.polyline(positions.map(position => [position.lat, position.lng]), {
              color, weight: 3, opacity: 0.75, interactive: false
            }).addTo(pins);
          }
          positions.forEach((position, index) => {
            const label = document.createElement('span');
            label.textContent = `Trip #${trip.id} · sample ${index + 1} · ${new Date(position.recorded_at).toLocaleTimeString()}`;
            L.marker([position.lat, position.lng], { title: label.textContent, alt: label.textContent, icon: L.divIcon({
              className: '', html: `<div style="--trip-color:${color}"><div class="position-pin"></div><span class="pin-label${left ? ' left' : ''}">#${trip.id}</span></div>`, iconSize: [14, 14], iconAnchor: [history ? 7 : (left ? 14 : 0), 14]
            }) }).bindPopup(label).addTo(pins);
          });
        });
        mapStatus.textContent = history ? `Trip #${selectedTrip} · ${trips[0].positions.length} recorded positions` : `Live · ${trips.length} active rides · colored pins clear on completion`;
      }
      document.getElementById('live-map').addEventListener('click', () => {
        selectionVersion++;
        selectedTrip = null;
        document.getElementById('live-map').hidden = true;
        if (map) map.fitBounds(bounds, { padding: [30, 30] });
        drawTrips(liveTrips);
      });
      async function selectTrip(id) {
        const version = ++selectionVersion;
        selectedTrip = id;
        document.getElementById('live-map').hidden = false;
        if (pins) pins.clearLayers();
        mapStatus.textContent = `Loading trip #${id}…`;
        try {
          const response = await fetch(`/simulator/trips/${id}/positions`, { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const trip = await response.json();
          if (version !== selectionVersion) return;
          drawTrips([trip], true);
          if (map && trip.positions.length) map.fitBounds(L.latLngBounds(trip.positions.map(position => [position.lat, position.lng])), { padding: [30, 30], maxZoom: 16 });
        } catch (error) {
          if (version === selectionVersion) mapStatus.textContent = `Cannot load trip #${id}: ${error.message}`;
        }
      }
      document.getElementById('show-instructions').addEventListener('click', () => document.getElementById('instructions').showModal());
      const element = (tag, text, className) => {
        const node = document.createElement(tag);
        if (text !== undefined) node.textContent = text;
        if (className) node.className = className;
        return node;
      };
      const replace = (id, children) => document.getElementById(id).replaceChildren(...children);
      async function refresh() {
        try {
          const response = await fetch('/simulator/snapshot', { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          baseline ||= data.counts;
          if (!starting) {
            startButton.disabled = data.runner.running;
            startButton.textContent = data.runner.running ? 'Running…' : 'Run 10 trips';
            if (data.runner.running) runStatus.textContent = 'Running · max 2';
            else if (runStatus.textContent === 'Running · max 2' || runStatus.textContent === 'Running · max 2 rides') runStatus.textContent = 'Stopped · see log/simulator.log';
          }
          liveTrips = data.active;
          const activeIds = new Set(liveTrips.map(trip => trip.id));
          for (const id of tripColors.keys()) if (!activeIds.has(id)) tripColors.delete(id);
          liveTrips.forEach(trip => colorForTrip(trip.id));
          if (selectedTrip === null) drawTrips(liveTrips);
          replace('counts', Object.entries(data.counts).map(([label, count]) => {
            const card = element('div', undefined, 'counter');
            const delta = count - baseline[label];
            card.append(element('span', label), element('strong', count.toLocaleString()), element('span', `${delta >= 0 ? '+' : ''}${delta.toLocaleString()}`, 'delta'));
            return card;
          }));
          document.getElementById('pool-summary').textContent = `· ${data.drivers.filter(driver => !driver.busy).length} idle / ${data.drivers.filter(driver => driver.busy).length} active`;
          replace('drivers', data.drivers.length ? [...data.drivers].sort((a, b) => Number(b.busy) - Number(a.busy) || a.id - b.id).map(driver => element('div', `🛞 ${shortName(driver.name)} · ${driver.busy ? 'Active' : 'Idle'}`, `driver${driver.busy ? ' busy' : ''}`)) : [element('p', 'No drivers yet. Use “How to run” to prepare the pool.')]);
          replace('active', data.active.length ? data.active.map(trip => {
            const card = element('article', undefined, 'ride');
            card.style.setProperty('--trip-color', colorForTrip(trip.id));
            card.append(element('span', trip.samples ? 'In transit' : 'Assigned / awaiting position', 'badge'), element('strong', `Trip #${trip.id}`), element('p', `🛞 ${shortName(trip.driver)} → 🙋 ${shortName(trip.rider)}`), element('p', `${shortLocation(trip.origin)} → ${shortLocation(trip.destination)}`), element('p', `${trip.samples} position samples recorded`));
            return card;
          }) : [element('p', 'No active rides. Drivers are ready for the next request.', 'muted')]);
          const rideRows = trips => trips.map(trip => {
            const row = element('tr');
            const tripCell = element('td');
            const link = element('button', `#${trip.id}`, 'trip-link');
            link.type = 'button';
            link.setAttribute('aria-label', `Show positions for trip ${trip.id}`);
            link.setAttribute('aria-pressed', String(selectedTrip === trip.id));
            link.addEventListener('click', () => selectTrip(trip.id));
            tripCell.append(link);
            row.append(tripCell);
            [`🛞 ${shortName(trip.driver)} / 🙋 ${shortName(trip.rider)}`, `${shortLocation(trip.origin)} → ${shortLocation(trip.destination)}`, trip.samples, trip.rating ? `${'★'.repeat(trip.rating)} (${trip.rating}/5)` : 'Awaiting rating'].forEach(value => row.append(element('td', value)));
            return row;
          });
          replace('recent', rideRows(data.recent.slice(0, 3)));
          replace('older', rideRows(data.recent.slice(3)));
          document.getElementById('history').hidden = data.recent.length <= 3;
          document.getElementById('history-count').textContent = `(${Math.max(0, data.recent.length - 3)})`;
          const status = document.getElementById('status');
          status.className = 'muted';
          status.textContent = `Live · ${new Date(data.captured_at).toLocaleTimeString()}`;
        } catch (error) {
          const status = document.getElementById('status');
          status.className = 'error';
          status.textContent = `Connection unavailable (${error.message}). Retrying…`;
        } finally {
          setTimeout(refresh, document.hidden ? 5000 : 1000);
        }
      }
      refresh();
    })();
  </script>
</body>
</html>
